<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Notch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.notch.spotify-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notch</string>
			</array>
		</dict>
	</array>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Notch shows your upcoming events and meeting join links in the notch timeline.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Notch needs full calendar access to display a scrolling timeline of the next 24 hours and detect meeting links.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Notch communicates with Music and Spotify to read the current track when system now-playing data is unavailable.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Notch displays the current track, album artwork, and synchronized lyrics for the media you are playing.</string>
	<key>NSLocationUsageDescription</key>
	<string>Notch uses your approximate location to show the current weather in the notch header.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Notch uses your approximate location to show the current weather in the notch header.</string>
</dict>
</plist>
